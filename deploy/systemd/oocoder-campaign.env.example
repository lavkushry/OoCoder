# Copy to /etc/oocoder/campaign.env (mode 0640, root:oocoder)

# OOCODER_HOME is set in the unit; override only if needed.
# OOCODER_HOME=/var/lib/oocoder

# Cursor credential for the local Agent SDK coding brain (never commit the real file).
# When this file exists, implement turns use Cursor local runtime. Grok is used only
# when no Cursor credential is present. Do not put the key on a command line.
# CURSOR_API_KEY_FILE=/etc/oocoder/cursor_api_key

# GitHub: rely on `gh auth login` as user oocoder, or:
# GH_TOKEN=ghp_...

# Watch behavior
WATCH_INTERVAL_SEC=300
OPEN_PRS=0
# OPEN_LIMIT=3
DRY_RUN=0
OOCODER_RUNTIME=local
OOCODER_MODEL=composer-2.5
