# Required for local/cloud Cursor SDK coding runs
CURSOR_API_KEY=

# Optional: override OoCoder home (default ~/.oocoder)
# OOCODER_HOME=

# Agent SDK GitHub channel — comma-separated owner/repo list
# OOCODER_GITHUB_REPOS=owner/repo

# Optional git identity for commits
# GIT_AUTHOR_NAME=OoCoder
# GIT_AUTHOR_EMAIL=oocoder@users.noreply.github.com
